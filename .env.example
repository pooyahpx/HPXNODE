SERVICE_PORT = 62050
NODE_HOST = "0.0.0.0"

# use absolute path

# XRAY_EXECUTABLE_PATH = /usr/local/bin/xray
# XRAY_ASSETS_PATH = /usr/local/share/xray

SSL_CERT_FILE = /var/lib/hpx-node/certs/ssl_cert.pem
SSL_KEY_FILE = /var/lib/hpx-node/certs/ssl_key.pem

# api key must be a valid uuid (you can use any version you want)
API_KEY = xxxxxxxx-yyyy-zzzz-mmmm-aaaaaaaaaaa

### can be rest or grpc
# SERVICE_PROTOCOL = grpc

### developer options
# DEBUG = false
# GENERATED_CONFIG_PATH = /var/lib/hpx-node/generated
# LOG_BUFFER_SIZE = 10000
# STARTUP_LOG_TAIL_SIZE = 200
# STATS_UPDATE_INTERVAL_SECONDS = 10
# STATS_CLEANUP_INTERVAL_SECONDS = 300

### WireGuard host NAT
### Built-in routing enables runtime IPv4 forwarding and manages scoped nft NAT/forwarding rules.
### IKEv2: this node's own public hostname.
### Set it and the node obtains (and auto-renews) its own Let's Encrypt
### certificate for that name over HTTP-01, and uses the name as the IKE
### identity — instead of the certificate shipped in the panel's core config.
### Native clients (Android's built-in IKEv2 especially) need a certificate
### whose SAN is exactly the hostname the user types, so this lets one shared
### core config serve every node. Requires the DNS record to point here and
### port 80 to be reachable during issuance/renewal.
# HPX_NODE_IKEV2_DOMAIN = node1.example.com
# HPX_NODE_IKEV2_HTTP_PORT = 80

# HPX_NODE_WG_HOST_ROUTING = 1
# HPX_NODE_WG_NAT_OUTPUT_INTERFACE = eth0
# HPX_NODE_WG_NAT_EGRESS_ONLY = 0
